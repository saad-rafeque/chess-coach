<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the app through cloud backup or device-to-device transfer
     (the Google sign-in stays on this phone; progress moves through Chess Coach's own sync). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
